;;; tests/e2e/app-input-and-widgets.scm — Interactive notcurses app for tui-test.

(use-modules (rnrs bytevectors)
             (system foreign)
             (notcurses))

(define (dim-yx plane)
  (let ((ry (make-bytevector 4 0))
        (rx (make-bytevector 4 0)))
    (ncplane_dim_yx plane (bytevector->pointer ry) (bytevector->pointer rx))
    (values (bytevector-u32-native-ref ry 0)
            (bytevector-u32-native-ref rx 0))))

(define (run-widget-checks nc std)
  ;; 1. ncselector: 3 items + NULL sentinel, press Down, check ncselector_selected == "beta"
  (let* ((items-bv (make-bytevector (* 4 16) 0))
         (s-opt0 (string->pointer "alpha"))
         (s-desc0 (string->pointer "First"))
         (s-opt1 (string->pointer "beta"))
         (s-desc1 (string->pointer "Second"))
         (s-opt2 (string->pointer "gamma"))
         (s-desc2 (string->pointer "Third")))
    ;; Populate ncselector_item[3] (16 bytes each: option @ 0, desc @ 8)
    (bytevector-u64-native-set! items-bv 0 (pointer-address s-opt0))
    (bytevector-u64-native-set! items-bv 8 (pointer-address s-desc0))
    (bytevector-u64-native-set! items-bv 16 (pointer-address s-opt1))
    (bytevector-u64-native-set! items-bv 24 (pointer-address s-desc1))
    (bytevector-u64-native-set! items-bv 32 (pointer-address s-opt2))
    (bytevector-u64-native-set! items-bv 40 (pointer-address s-desc2))
    (let* ((sopts (make-ncselector-options
                   #:title "Pick"
                   #:items items-bv
                   #:defidx 0
                   #:maxdisplay 3))
           (splane (ncplane_create std (nc-struct-ptr
                                        (make-ncplane-options #:y 6 #:x 2 #:rows 8 #:cols 30))))
           (sel (ncselector_create splane (nc-struct-ptr sopts)))
           (ni (make-ncinput)))
      (ncinput-set-id! ni NCKEY_DOWN)
      (ncinput-set-evtype! ni NCTYPE_PRESS)
      (ncselector_offer_input sel (nc-struct-ptr ni))
      (let ((picked (c-string->scheme (ncselector_selected sel))))
        (ncplane_printf_yx std 15 0 "SEL:~a" picked)
        (ncselector_destroy sel %null-pointer))))

  ;; 2. ncreader: offer 'h', 'i', check ncreader_contents == "hi"
  (let* ((ropts (make-ncreader-options))
         (rplane (ncplane_create std (nc-struct-ptr
                                      (make-ncplane-options #:y 6 #:x 35 #:rows 3 #:cols 20))))
         (rdr (ncreader_create rplane (nc-struct-ptr ropts)))
         (ni (make-ncinput)))
    (ncinput-set-evtype! ni NCTYPE_PRESS)
    (ncinput-set-id! ni (char->integer #\h))
    (bytevector-u8-set! (nc-struct-bv ni) 12 (char->integer #\h))
    (bytevector-u32-native-set! (nc-struct-bv ni) 36 (char->integer #\h))
    (ncreader_offer_input rdr (nc-struct-ptr ni))
    (ncinput-set-id! ni (char->integer #\i))
    (bytevector-u8-set! (nc-struct-bv ni) 12 (char->integer #\i))
    (bytevector-u32-native-set! (nc-struct-bv ni) 36 (char->integer #\i))
    (ncreader_offer_input rdr (nc-struct-ptr ni))
    (let ((txt (c-string-free->scheme (ncreader_contents rdr))))
      (ncplane_printf_yx std 16 0 "READER:~a" txt)
      (ncreader_destroy rdr %null-pointer)))

  ;; 3. ncmenu: create a 1-section menu and destroy it
  (let* ((mitem (make-ncmenu-item #:desc "Quit"))
         (msec (make-ncmenu-section #:name "File" #:itemcount 1 #:items mitem))
         (mopts (make-ncmenu-options #:sections msec #:sectioncount 1))
         (menu (ncmenu_create std (nc-struct-ptr mopts))))
    (ncplane_printf_yx std 17 0 "MENU:~a" (if (null-pointer? menu) "fail" "ok"))
    (unless (null-pointer? menu)
      (ncmenu_destroy menu))))

(let* ((opts (make-notcurses-options #:flags NCOPTION_SUPPRESS_BANNERS))
       (nc (notcurses_init (nc-struct-ptr opts) %null-pointer)))
  (when (null-pointer? nc)
    (error "notcurses_init failed"))
  (notcurses_mice_enable nc NCMICE_BUTTON_EVENT)
  (sync-known-size!)
  (let ((std (notcurses_stdplane nc))
        (ni (make-ncinput)))
    (ncplane_putstr_yx std 0 0 (string->pointer "READY"))
    (ncplane_putstr_yx std 2 4 (string->pointer "CLICK_ME"))
    (notcurses_render nc)
    (let loop ()
      (let ((id (let poll ()
                  (let ((r (notcurses_get_nblock nc (nc-struct-ptr ni))))
                    (cond
                      ((and (not (= r 0)) (not (= r 4294967295))) r)
                      ((terminal-size-changed?) NCKEY_RESIZE)
                      (else (sleep-ms 20) (poll)))))))
        (cond
          ((= (ncinput-evtype ni) NCTYPE_RELEASE)
           (loop))
          ((= id NCKEY_RESIZE)
           (notcurses_refresh nc %null-pointer %null-pointer)
           (sync-known-size!)
           (call-with-values (lambda () (dim-yx std))
             (lambda (r c)
               (ncplane_printf_yx std 4 0 "RESIZED:~ax~a" r c)
               (notcurses_render nc)))
           (loop))
          ((and (>= id NCKEY_BUTTON1) (<= id NCKEY_BUTTON10))
           (ncplane_printf_yx std 5 0 "MOUSE:~a@~a,~a"
                              (- id NCKEY_BUTTON1 -1)
                              (ncinput-y ni)
                              (ncinput-x ni))
           (notcurses_render nc)
           (loop))
          ((= id NCKEY_UP)
           (ncplane_putstr_yx std 1 0 (string->pointer "KEY:UP    "))
           (notcurses_render nc)
           (loop))
          ((and (ncinput_ctrl_p (nc-struct-ptr ni))
                (or (= id (char->integer #\k)) (= id (char->integer #\K))))
           (ncplane_putstr_yx std 1 0 (string->pointer "KEY:CTRL+k"))
           (notcurses_render nc)
           (loop))
          ((= id (char->integer #\w))
           (catch #t
             (lambda () (run-widget-checks nc std))
             (lambda (k . args)
               (ncplane_printf_yx std 18 0 "ERR:~a ~s" k args)))
           (notcurses_render nc)
           (loop))
          ((= id (char->integer #\q))
           (notcurses_stop nc))
          ((and (>= id 32) (< id 127))
           (ncplane_printf_yx std 1 0 "KEY:~a     " (integer->char id))
           (notcurses_render nc)
           (loop))
          (else (loop)))))))
