#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT_DIR="${ROOT_DIR}/ccache"

export GUILE_LOAD_PATH="${ROOT_DIR}${GUILE_LOAD_PATH:+:$GUILE_LOAD_PATH}"
export GUILE_LOAD_COMPILED_PATH="${OUT_DIR}${GUILE_LOAD_COMPILED_PATH:+:$GUILE_LOAD_COMPILED_PATH}"

mkdir -p "${OUT_DIR}/notcurses/compat"

compile_one() {
    local src="$1"
    local rel="${src#${ROOT_DIR}/}"
    local dst="${OUT_DIR}/${rel%.scm}.go"
    mkdir -p "$(dirname "$dst")"
    guild compile -O2 -Wunbound-variable -Warity-mismatch -Wunused-variable -Wshadowed-toplevel \
        -L "${ROOT_DIR}" -o "$dst" "$src"
}

compile_one "${ROOT_DIR}/notcurses/ffi.scm"
compile_one "${ROOT_DIR}/notcurses/constants.scm"
compile_one "${ROOT_DIR}/notcurses/structs.scm"
for f in "${ROOT_DIR}"/notcurses/*.scm; do
    case "$f" in
        */ffi.scm|*/constants.scm|*/structs.scm) continue ;;
    esac
    compile_one "$f"
done
compile_one "${ROOT_DIR}/notcurses.scm"
compile_one "${ROOT_DIR}/notcurses/compat/curses.scm"
